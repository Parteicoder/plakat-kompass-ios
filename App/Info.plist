<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Diese Datei wird ueber INFOPLIST_FILE eingebunden, nicht von XcodeGen erzeugt.
	  Vorher stand in project.yml ein "info:"-Block, der genau hierher schrieb und dabei
	  alles unterhalb ueberschrieb - Berechtigungstexte und Dateityp inklusive.

	  Die Werte in $(...) kommen aus den Bau-Einstellungen in project.yml. Wer sie dort
	  aendert, aendert sie hier mit; doppelt gepflegt wird nichts.
	-->
	<key>CFBundleDevelopmentRegion</key>
	<string>de</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<key>CFBundleDisplayName</key>
	<string>Plakat Kompass</string>

	<!--
	  Startbildschirm ohne Eintraege: Damit nimmt iOS die Systemhintergrundfarbe und wechselt
	  von allein zwischen hell und dunkel. Bewusst kein Logo und kein Schriftzug - Apples
	  Richtlinie will einen Startbildschirm, der wie die erste Seite der App aussieht, damit
	  der Start kurz wirkt. Ein Begruessungsbild tut das Gegenteil.
	-->
	<key>UILaunchScreen</key>
	<dict/>

	<!-- Nur Hochformat: Erfasst wird im Stehen, mit einer Hand, vor einem Laternenmast. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!-- Ohne diese Texte stuerzt die App beim ersten Zugriff ab, statt zu fragen. -->
	<key>NSCameraUsageDescription</key>
	<string>Für jedes Plakat wird ein Foto aufgenommen, damit das Team und die Verwaltung den Zustand nachvollziehen können.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Der Standort wird beim Erfassen gespeichert, damit das Plakat auf der Karte wiedergefunden und rechtzeitig abgenommen werden kann.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Wird nur gebraucht, wenn statt der Kamera ein vorhandenes Foto gewählt wird.</string>

	<!--
	  Nur für Flyer-Touren, und nur solange eine läuft. Ohne „Immer“ bricht die Aufzeichnung
	  ab, sobald das Telefon in die Tasche wandert — genau dann, wenn man verteilt.
	  Die App sagt es, wenn die Berechtigung fehlt, statt still weniger zu tun.
	-->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Während einer Flyer-Tour wird der zurückgelegte Weg aufgezeichnet, damit das Team sieht, welche Straßen schon versorgt sind. Außerhalb einer Tour wird nichts aufgezeichnet.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>

	<!--
	  Der Funk-Abgleich mit Android über Nearby Connections. Auf iOS traegt dabei nur das WLAN,
	  und das laeuft ueber Bonjour.

	  BEIDE Eintraege sind Pflicht, und BEIDE scheitern lautlos:
	  - Ohne NSLocalNetworkUsageDescription beendet iOS die App beim ersten Suchlauf.
	  - Ohne den passenden Eintrag in NSBonjourServices blockt iOS seit 14 jede Suche nach
	    diesem Typ. Kein Absturz, kein Log - es wird einfach nie ein Geraet gefunden.

	  Der Typ ist NICHT frei waehlbar. Nearby leitet ihn aus der Dienstkennung ab:
	  "_" + erste sechs Byte von SHA-256("de.bsw.plakatradar.LOCAL_SYNC") in Grosshex + "._tcp".
	  Gerechnet wird das in NearbyDienst.swift, und NearbyDienstTests haelt den Wert hier fest -
	  samt Gegenprobe an Googles eigenem Beispiel.
	-->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Für den Abgleich mit den Geräten deines Teams in der Nähe. Angesprochen werden nur Geräte mit demselben Team-Schlüssel, und die Daten verlassen das lokale Netz nicht.</string>
	<key>NSBonjourServices</key>
	<array>
		<!-- de.bsw.plakatradar.LOCAL_SYNC - der Abgleich zwischen Teamgeraeten. -->
		<string>_EA0A851F84A0._tcp</string>
		<!--
		  de.bsw.plakatradar.DEVICE_BACKUP - der Handywechsel.

		  Eigener Dienst, weil sich beim Abgleich ALLE Teamgeraete verbinden, beim Umzug aber
		  genau zwei - und das neue Geraet noch gar kein Team hat. Fehlt dieser Eintrag, sucht
		  das iPhone beim Handywechsel lautlos ins Leere: kein Absturz, keine Meldung, nie ein
		  Geraet. Genau dieselbe Falle wie oben, nur ein zweites Mal.
		-->
		<string>_27F69BB0892F._tcp</string>
	</array>

	<!--
	  Der Kern des Android-iOS-Abgleichs: Damit taucht Plakat Kompass in "Öffnen mit" auf,
	  wenn ein Sync-Paket aus einem Messenger, aus Mail oder per AirDrop hereinkommt.
	  Die Endung .prsync und der Typ entsprechen dem, was die Android-App verschickt.
	-->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>de.bsw.plakatradar.sync</string>
			<key>UTTypeDescription</key>
			<string>Plakat Kompass Sync-Paket</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>prsync</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.plakatradar.sync</string>
					<string>application/octet-stream</string>
				</array>
			</dict>
		</dict>
	</array>

	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Plakat Kompass Sync-Paket</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>de.bsw.plakatradar.sync</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
