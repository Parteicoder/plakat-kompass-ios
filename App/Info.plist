<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Diese Datei wird ueber INFOPLIST_FILE eingebunden, nicht von XcodeGen erzeugt.
	  Vorher stand in project.yml ein "info:"-Block, der genau hierher schrieb und dabei
	  alles unterhalb ueberschrieb - Berechtigungstexte und Dateityp inklusive.

	  Die Werte in $(...) kommen aus den Bau-Einstellungen in project.yml. Wer sie dort
	  aendert, aendert sie hier mit; doppelt gepflegt wird nichts.
	-->
	<key>CFBundleDevelopmentRegion</key>
	<string>de</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<key>CFBundleDisplayName</key>
	<string>Plakat Kompass</string>

	<!--
	  Startbildschirm ohne Eintraege: Damit nimmt iOS die Systemhintergrundfarbe und wechselt
	  von allein zwischen hell und dunkel. Bewusst kein Logo und kein Schriftzug - Apples
	  Richtlinie will einen Startbildschirm, der wie die erste Seite der App aussieht, damit
	  der Start kurz wirkt. Ein Begruessungsbild tut das Gegenteil.
	-->
	<key>UILaunchScreen</key>
	<dict/>

	<!-- Nur Hochformat: Erfasst wird im Stehen, mit einer Hand, vor einem Laternenmast. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!-- Ohne diese Texte stuerzt die App beim ersten Zugriff ab, statt zu fragen. -->
	<key>NSCameraUsageDescription</key>
	<string>Für jedes Plakat wird ein Foto aufgenommen, damit das Team und die Verwaltung den Zustand nachvollziehen können.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Der Standort wird beim Erfassen gespeichert, damit das Plakat auf der Karte wiedergefunden und rechtzeitig abgenommen werden kann.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Wird nur gebraucht, wenn statt der Kamera ein vorhandenes Foto gewählt wird.</string>

	<!--
	  Der Kern des Android-iOS-Abgleichs: Damit taucht Plakat Kompass in "Öffnen mit" auf,
	  wenn ein Sync-Paket aus einem Messenger, aus Mail oder per AirDrop hereinkommt.
	  Die Endung .prsync und der Typ entsprechen dem, was die Android-App verschickt.
	-->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>de.bsw.plakatradar.sync</string>
			<key>UTTypeDescription</key>
			<string>Plakat Kompass Sync-Paket</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>prsync</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.plakatradar.sync</string>
					<string>application/octet-stream</string>
				</array>
			</dict>
		</dict>
	</array>

	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Plakat Kompass Sync-Paket</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>de.bsw.plakatradar.sync</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
